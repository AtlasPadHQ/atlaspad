{
  "name": "cornershop",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "description": "CORNERSHOP - launch a coin for any business on earth. Demo mode (simulated) + real mode on Solana (devnet now, mainnet via go-mainnet).",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:devnet": "VITE_CLUSTER=devnet VITE_TEST_WALLET=1 vite",
    "worker:devnet": "wrangler dev --env devnet --port 8787",
    "build": "npm run typecheck && vite build",
    "build:devnet": "npm run typecheck && VITE_CLUSTER=devnet VITE_TEST_WALLET=1 vite build --outDir dist-devnet --emptyOutDir",
    "build:mainnet": "npm run typecheck && VITE_CLUSTER=mainnet VITE_TEST_WALLET= vite build --outDir dist-mainnet --emptyOutDir",
    "vault-client": "npm --prefix programs/shop-vault/client ci && npm --prefix programs/shop-vault/client run build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "preview": "vite preview",
    "check:bundle": "node scripts/check-bundle.mjs",
    "deploy": "echo \"Refusing: use deploy:devnet (this workflow). The demo Worker is deployed only by the integrator; mainnet only via scripts/go-mainnet.mjs.\" && exit 1",
    "deploy:devnet": "bash scripts/deploy-devnet.sh",
    "smoke:devnet": "node scripts/smoke.mjs https://cornershop-devnet.tiejiucai.workers.dev --cluster devnet",
    "e2e:devnet": "node scripts/e2e-devnet.ts",
    "e2e:chain": "CHAIN_E2E=devnet vitest run --config src/chain/__e2e__/vitest.config.ts",
    "fixtures:chain": "node src/chain/__fixtures__/capture-devnet.mjs",
    "audit:accuracy": "node scripts/accuracy-audit.mjs https://cornershop-devnet.tiejiucai.workers.dev",
    "watchdog:devnet": "node scripts/watchdog.mjs --cluster devnet",
    "go-mainnet": "node scripts/go-mainnet.mjs --dry-run"
  },
  "dependencies": {
    "@cornershop/shop-vault-client": "file:programs/shop-vault/client",
    "@noble/hashes": "1.8.0",
    "@pump-fun/pump-sdk": "3.2.0",
    "@pump-fun/pump-swap-sdk": "2.1.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@solana/web3.js": "1.99.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/wallet": "1.1.1",
    "bn.js": "5.2.2",
    "bs58": "^6.0.0",
    "buffer": "6.0.3",
    "maplibre-gl": "^6.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@solana/spl-token": "0.4.14",
    "@types/bn.js": "5.2.0",
    "@types/google.maps": "^3.66.5",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
