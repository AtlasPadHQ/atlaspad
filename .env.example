# AtlasPad environment — NAMES ONLY. Never put real values in this file; it is committed.
#
# ---------------------------------------------------------------------------------------------- browser build (.env.local)
# Public by design, but only these VITE_* names may ever reach the client bundle.
# Google browser key: Maps JavaScript API + Places API (New) + Places UI Kit, referrer-restricted to
# https://atlaspad.online/*, the Workers URLs and localhost:5173/4173. Empty = MapLibre/OSM demo map.
VITE_GOOGLE_MAPS_KEY=
# Build-time cluster (set by the npm scripts; leave empty here): devnet | mainnet | empty (= demo-only build).
VITE_CLUSTER=
# Devnet test wallet: "1" only in devnet builds (build:devnet). build:mainnet forces it empty; check-bundle proves it.
VITE_TEST_WALLET=
# Optional: where `vite dev` proxies /api/* (defaults to wrangler dev on http://127.0.0.1:8787).
# CS_API_PROXY=http://127.0.0.1:8787

# ---------------------------------------------------------------------------------------------- server only (.env.server)
# These live in .env.server (gitignored). They are set on the Workers ONLY through the scripts, which pipe them into
# `wrangler secret bulk|put` via stdin (bash scripts/deploy-devnet.sh, node scripts/go-mainnet.mjs,
# node scripts/lib/secretPut.mjs). NEVER prefix them with VITE_, never import them into client code, never print them.
#
# Solana RPC (Alchemy app with Solana Devnet + Mainnet enabled). The Worker builds
# https://solana-<cluster>.g.alchemy.com/v2/<key> itself; the key never appears in the browser or a response.
# ALCHEMY_API_KEY=
# Optional per-cluster keys (a separate AtlasPad app/plan for mainnet is recommended); they win over ALCHEMY_API_KEY.
# ALCHEMY_API_KEY_DEVNET=
# ALCHEMY_API_KEY_MAINNET=
#
# Google server key: Places API (New) + Maps Grounding Lite, no application restriction.
# GOOGLE_SERVER_KEY=
#
# Twilio Verify (mainnet phone calls; the Verify service must have code length 6 and voice geo permissions).
# Devnet shows the code on screen and does not need them.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SID=
#
# Cloudflare Turnstile secret (required on mainnet; the public site key goes in wrangler.jsonc env.*.vars.TURNSTILE_SITE_KEY).
# TURNSTILE_SECRET_KEY=
#
# Optional: Jupiter API key (mainnet fallback route, P2).
# JUPITER_API_KEY=
#
# Owner alerts (claims, disputes, reports, opt-outs, critical monitor alerts). Mainnet needs at least ONE of these two:
# ALERT_EMAIL_TO  free: the Worker emails each alert from alerts@atlaspad.online through Cloudflare Email Routing. Use an
#                 address that is a VERIFIED destination address in Email Routing (dashboard → atlaspad.online → Email →
#                 Email Routing → Destination addresses), e.g. ALERT_EMAIL_TO=owner@example.com. Never commit it.
# ALERT_WEBHOOK_URL  a Discord/Slack incoming webhook.
# ALERT_EMAIL_TO=
# ALERT_WEBHOOK_URL=
#
# Optional, public: Privy app id (email login). Without it "Continue with email" stays hidden in real mode.
# PRIVY_APP_ID=

# ---------------------------------------------------------------------------------------------- generated from .keys/ (never in .env files)
# The scripts derive these Worker secrets from key files in .keys/ (gitignored, mode 600) and never print them:
#   ATTESTOR_SECRET    .keys/<cluster>-attestor.json   base64(seed ‖ pubkey); co-signs launches/claims only
#   CRANK_SECRET       .keys/<cluster>-crank.json      pays for finalize_claim and the fee crank
#   HMAC_KEY           .keys/<cluster>-hmac.key        32 random bytes (phone/IP/token hashes)
#   DEV_FAUCET_SECRET  .keys/devnet-faucet.json        DEVNET ONLY — must never exist on mainnet (H6)
# Local `wrangler dev`: `node scripts/dev-vars.mjs devnet` writes .dev.vars.devnet (mode 600, gitignored).
